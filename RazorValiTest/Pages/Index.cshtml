@page
@model IndexModel

@{
    ViewData["Title"] = "List of Cars";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Test cars</h1>
        <p class="text-muted mb-0">Cars loaded from the in-memory repository.</p>
    </div>
    <span class="badge text-bg-primary fs-6">@Model.Cars.Count car@(Model.Cars.Count == 1 ? "" : "s")</span>
</div>

@if (Model.Cars.Count == 0)
{
    <div class="alert alert-info" role="alert">
        No test cars are available.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Vendor</th>
                <th scope="col">Model</th>
                <th scope="col">Color</th>
                <th scope="col">Odometer</th>
                <th scope="col">Engine kind</th>
                <th scope="col">Engine power</th>
                <th scope="col">Doors</th>
                <th scope="col">Towbar</th>
                <th scope="col">Year</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var car in Model.Cars)
            {
                <tr>
                    <td>@car.Id</td>
                    <td class="fw-semibold">@car.Vendor</td>
                    <td>@car.Model</td>
                    <td>@car.Color</td>
                    <td>@car.Odometer.ToString("N0") km</td>
                    <td>@car.EngineKind</td>
                    <td>@car.EnginePower hp</td>
                    <td>@car.Doors</td>
                    <td>@(car.Towbar ? "Yes" : "No")</td>
                    <td>@car.Year</td>
                </tr>
            }
        </tbody>
            <div class="col-3">
                <div class="row">
                    <a asp-page="/Create" class="btn btn-primary">Create new car</a>
                </div>
        </table>
    </div>
}
